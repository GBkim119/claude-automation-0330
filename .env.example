# ============================================================
#  .env.example — 환경변수 템플릿
#  이 파일을 복사해서 .env 로 저장하고 값을 채워주세요:
#    cp .env.example .env
# ============================================================

# ── 텔레그램 설정 ────────────────────────────────────────────
# BotFather에서 /newbot 으로 봇 생성 후 받은 토큰
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 메시지를 받을 채팅 ID
# 확인 방법: 텔레그램에서 @userinfobot 에게 메시지 보내기
TELEGRAM_CHAT_ID=your_chat_id_here

# ── GitHub 설정 ──────────────────────────────────────────────
# 깃허브 유저명 (프로필 URL의 마지막 부분)
GITHUB_USERNAME=your_github_username

# ── 기본 프로젝트 설정 (선택사항) ───────────────────────────
# 프로젝트를 생성할 기본 디렉토리 (비워두면 ~/Projects 사용)
DEFAULT_PROJECTS_DIR=

# 기본 저장소 공개 설정: public 또는 private
DEFAULT_VISIBILITY=public
